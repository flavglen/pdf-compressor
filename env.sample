# ---------------------------------------------------------------------------
# pdf-compressor — server environment variables
# ---------------------------------------------------------------------------
# Every variable is optional: the server falls back to the default shown here
# (see the Configuration table in README.md and the config block at the top of
# server/index.js).
#
# To use this file, copy it and edit the values you care about:
#
#   cp env.sample .env
#
# The server does not bundle dotenv, so a .env file is only read when you tell
# Node to load it (Node 20.6+):
#
#   node --env-file=.env server/index.js
#   node --env-file-if-exists=.env --watch server/index.js   # from server/
#
# Without --env-file, plain `cp env.sample .env` has no effect — instead export
# the variables in your shell (or prefix the start command) before launching.
#
# This file is committed, so it must stay free of real credentials: it only
# lists defaults. Keep anything sensitive in .env, which is git-ignored.
# ---------------------------------------------------------------------------

# API port.
# Default: 3001
PORT=3001

# Bind address. 127.0.0.1 keeps the API reachable from this machine only.
# Set to 0.0.0.0 to expose the API to your LAN (see the README warning first).
# Default: 127.0.0.1
HOST=127.0.0.1

# Path to the Ghostscript binary ("gs" means: look it up on PATH).
# Set this when Ghostscript lives somewhere unusual, e.g.
#   macOS (Homebrew, Apple silicon): /opt/homebrew/bin/gs
#   macOS (Homebrew, Intel):         /usr/local/bin/gs
#   Debian/Ubuntu:                   /usr/bin/gs
#   Windows:                         C:\Program Files\gs\gs10.05.1\bin\gswin64c.exe
# Default: gs
GS_BIN=gs

# Kill a runaway conversion after this many milliseconds.
# Default: 300000 (5 minutes)
GS_TIMEOUT_MS=300000

# Uploaded originals and compressed outputs are deleted after this many
# milliseconds. The sweeper runs at startup and every 15 minutes.
# Default: 3600000 (1 hour)
FILE_TTL_MS=3600000

# Hard upload cap, in bytes. Requests above it fail with HTTP 400.
# Default: 209715200 (200 MB)
MAX_UPLOAD_BYTES=209715200
